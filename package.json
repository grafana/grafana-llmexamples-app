{
  "name": "llm-examples",
  "version": "1.0.0",
  "description": "Examples of using LLMs inside a Grafana plugin",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "e2e": "npm exec cypress install && npm exec grafana-e2e run",
    "e2e:update": "npm exec cypress install && npm exec grafana-e2e run --update-screenshots",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.22.9",
    "@grafana/e2e": "10.0.3",
    "@grafana/e2e-selectors": "10.0.3",
    "@grafana/eslint-config": "5.1.0",
    "@grafana/tsconfig": "1.2.0-rc1",
    "@swc/core": "1.3.73",
    "@swc/helpers": "0.5.1",
    "@swc/jest": "0.2.27",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "12.1.5",
    "@types/jest": "29.5.3",
    "@types/lodash": "4.14.196",
    "@types/node": "18.17.1",
    "@types/react-router-dom": "5.3.3",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "6.8.1",
    "eslint-webpack-plugin": "4.0.1",
    "fork-ts-checker-webpack-plugin": "8.0.0",
    "glob": "10.3.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.6.2",
    "jest-environment-jsdom": "29.6.2",
    "prettier": "2.8.8",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.62.1",
    "sass-loader": "13.2.2",
    "style-loader": "3.3.2",
    "swc-loader": "0.2.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "4.8.4",
    "webpack": "5.88.2",
    "webpack-cli": "5.1.4",
    "webpack-livereload-plugin": "3.0.2"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@grafana/data": "^10.0.0",
    "@grafana/experimental": "1.7.4",
    "@grafana/runtime": "^10.0.0",
    "@grafana/ui": "^10.0.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "^5.2.0",
    "rxjs": "7.8.0",
    "tslib": "2.5.0"
  },
  "packageManager": "npm@8.3.1"
}
